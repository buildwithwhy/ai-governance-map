      "passages": [
        {
          "id": "S-0005#1",
          "locator": "Current and Prior Versions",
          "text": "Version 3.4 and redline (effective July 8, 2026) · Version 3.3 (effective May 26, 2026) · Version 3.2 (effective April 29, 2026) · Version 3.1 (effective April 2, 2026) · Version 3.0 (effective February 24, 2026) · Version 2.2 (effective May 14, 2025) · Version 2.1 (effective March 31, 2025) · Version 2.0 (effective October 15, 2024) · Version 1.0 (effective September 19, 2023)",
          "retrieved": "2026-10-08"
        },
        {
          "id": "S-0005#2",
          "locator": "Update log, April 29, 2026",
          "text": "Version 3.2 of our RSP authorizes the LTBT to request external review of Risk Reports, gives the LTBT the power to approve our selection of external reviewers, and formalizes a requirement that we provide the LTBT with regular briefings.",
          "retrieved": "2026-10-08"
        },
        {
          "id": "S-0005#3",
          "locator": "Update log, April 2, 2026 (v3.1)",
          "text": "We now clarify that, even if not required by the RSP, we remain free to take measures such as pausing the development of our AI systems in any circumstances in which we deem them appropriate.",
          "retrieved": "2026-10-08"
        },
        {
          "id": "S-0005#4",
          "locator": "Update log, February 24, 2026 / April 2, 2026",
          "text": "Version 3.0 is a comprehensive rewrite of the RSP. … [changes] will be logged both on this page and in a changelog in the policy document itself.",
          "retrieved": "2026-10-08"
        },
        {
          "id": "S-0005#5",
          "locator": "Risk Reports",
          "text": "Redacted Risk Report August 2026 · Redacted Risk Report February 2026",
          "retrieved": "2026-10-08"
        }
      ]
    },
